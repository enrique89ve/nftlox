{
	"name": "@nftlox/protocol",
	"version": "0.1.0",
	"description": "NFTLox Protocol — canonical types, constants, and pure functions",
	"license": "MIT",
	"author": "NFTLox",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nftlox/nftlox.git",
		"directory": "packages/protocol"
	},
	"homepage": "https://github.com/nftlox/nftlox/tree/master/packages/protocol#readme",
	"bugs": {
		"url": "https://github.com/nftlox/nftlox/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun build ./src/index.ts --target=node --format=esm --outdir=dist && bunx tsc -p tsconfig.build.json",
		"prepack": "bun run build",
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
