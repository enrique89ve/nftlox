FROM oven/bun:1.3.11-debian
WORKDIR /app

# Dokploy commonly builds from the monorepo root, so copy the package-local
# manifest and lockfile explicitly instead of relying on the Dockerfile folder
# as the build context.
COPY packages/indexer/package.json packages/indexer/bun.lock ./

# Install only runtime dependencies for the standalone indexer package.
RUN bun install --frozen-lockfile --production

COPY packages/indexer/ ./

RUN chmod +x /app/scripts/*.sh

ENV NODE_ENV=production
ENV ENABLE_SWAGGER=false

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
	CMD ["/app/scripts/docker-healthcheck.sh"]

EXPOSE 3050

ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["start"]
