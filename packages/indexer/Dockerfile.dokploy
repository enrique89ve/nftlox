# syntax=docker/dockerfile:1.7

# ───── Stage 1: Builder ─────
# Builds a standalone bundle with @nftlox/protocol inlined. Runs in the
# monorepo root context so Bun can resolve the workspace link.
FROM oven/bun:1.3.11 AS builder

WORKDIR /repo

# Workspace manifests — copied first so `bun install` caches when source
# changes but manifests don't. All workspaces (packages/*) must be
# declared for bun to install against the frozen lockfile, even though
# we only bundle the indexer.
COPY package.json bun.lock ./
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/indexer/package.json ./packages/indexer/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/packs-engine/package.json ./packages/packs-engine/
COPY packages/playground/package.json ./packages/playground/

# Install full workspace deps (dev + prod) — needed for the build step.
RUN bun install --frozen-lockfile

# Source code layers
COPY packages/protocol/ ./packages/protocol/
COPY packages/indexer/ ./packages/indexer/

# Bundle: @nftlox/protocol gets inlined; heavy / native-backed deps stay
# external so Bun can load them from node_modules at runtime (beekeeper
# ships WASM; elysia / postgres have large runtimes that don't benefit
# from bundling).
#
# Build both main bundle and sync-worker bundle (Web Workers can't be embedded).
WORKDIR /repo/packages/indexer
RUN bun build src/index.ts \
	--target=bun \
	--outfile=dist/indexer.js \
	--external @hiveio/beekeeper \
	--external @elysiajs/cors \
	--external @elysiajs/swagger \
	--external elysia \
	--external hive-tx \
	--external postgres && \
	bun build src/scanner/sync-worker.ts \
	--target=bun \
	--outfile=dist/sync-worker.js \
	--external @hiveio/beekeeper \
	--external postgres

# ───── Stage 2: Runtime ─────
FROM oven/bun:1.3.11

ARG BUILD_TIME
ARG GIT_COMMIT_SHA
ARG GIT_CURRENT_BRANCH

LABEL org.opencontainers.image.title="NFTLox Indexer"
LABEL org.opencontainers.image.description="Hive blockchain NFT indexer and API (Dokploy)"
LABEL org.opencontainers.image.source="https://github.com/nftlox/nftlox"
LABEL org.opencontainers.image.created="${BUILD_TIME}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT_SHA}"
LABEL io.nftlox.image.branch="${GIT_CURRENT_BRANCH}"

WORKDIR /app

# Preserve the workspace layout so Bun's isolated install layout resolves.
# External deps (postgres, elysia, etc.) live as symlinks in
# packages/indexer/node_modules/* that point at ../../../node_modules/.bun/*,
# which only works if both node_modules trees exist at the same relative paths.
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/packages/indexer/node_modules ./packages/indexer/node_modules
COPY --from=builder /repo/packages/indexer/dist ./packages/indexer/dist
COPY --from=builder /repo/packages/indexer/src/db/schema.sql ./packages/indexer/db/schema.sql
COPY --from=builder /repo/packages/indexer/scripts ./scripts

RUN chmod +x /app/scripts/*.sh && \
	chown -R bun:bun /app

USER bun

ENV NODE_ENV=production
ENV ENABLE_SWAGGER=false
ENV INDEXER_ENTRY=packages/indexer/dist/indexer.js

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
	CMD ["/app/scripts/docker-healthcheck.sh"]

EXPOSE 3050

ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["start"]
