# =============================================================================
# NFTLox Indexer Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Only POSTGRES_PASSWORD is required. Everything else has sensible defaults.
#
# Full reference: see the Configuration section in README.md
# =============================================================================

# ============ Required ============

# PostgreSQL password — no default in production.
POSTGRES_PASSWORD=change_me_in_production

# ============ Database ============

# Option A: Let Docker Compose manage PostgreSQL (default).
#   The compose builds DATABASE_URL automatically from these:
POSTGRES_DB=nftlox_indexer
POSTGRES_USER=nftlox
# POSTGRES_PORT=5432  # Only used by docker-compose.dev.yml

# Option B: Bring your own PostgreSQL (RDS, Supabase, etc.).
#   Set DATABASE_URL and run: docker compose up -d indexer
# DATABASE_URL=postgres://user:password@your-host:5432/nftlox_indexer

# ============ Multisig (optional) ============

# Set all three to enable marketplace buy/sell.
# Without these the indexer syncs and serves the API, but purchases are disabled.
# HIVE_ACCOUNT=your-node-account
# ACTIVE_KEY=5J...
# BEEKEEPER_PASSWORD=change_me_in_production

# ============ Tuning (optional — defaults work for most deployments) ============

# GENESIS_BLOCK=105530500         # Protocol genesis block (default). Override only for partial re-indexes.
# ALLOW_UNSAFE_GENESIS_BLOCK=false
# BATCH_SIZE=1000
# SYNC_INTERVAL_MS=3000
# LOG_LEVEL=info                  # debug | info | warn | error
# INDEXER_PORT=3050
# INDEXER_ROLE=both               # sync | api | both
# HIVE_ENDPOINTS=https://api.syncad.com,https://rpc.mahdiyari.info,https://api.hive.blog

# ============ Security (optional) ============

# ALLOWED_ORIGINS=https://app.example.com  # Comma-separated CORS allowlist
# ENABLE_SWAGGER=false                     # Auto-disabled in production

# ============ Health probes (optional) ============

# HEALTH_PORT=3051  # Separate port for /live and /ready (0 = disabled)

# ============ Rate limiting (optional) ============

# MULTISIG_RATE_LIMIT_MAX=10
# MULTISIG_RATE_LIMIT_WINDOW_MS=60000
# MULTISIG_IP_RATE_LIMIT_MAX=30
# MULTISIG_IP_RATE_LIMIT_WINDOW_MS=60000

# ============ Nginx (only with docker-compose.nginx.yml) ============

# PROXY_PORT=80
# PROXY_SSL_PORT=443
# SSL_CERT_PATH=./nginx/ssl
