# ============ Indexer ============
INDEXER_PORT=3050
GENESIS_BLOCK=103484900
PROTOCOL_ID=nftlox_testnet
BATCH_SIZE=1000
SYNC_INTERVAL_MS=3000
LOG_LEVEL=info

# Comma-separated Hive API endpoints (must support HafAH)
# HIVE_ENDPOINTS=https://api.syncad.com,https://rpc.mahdiyari.info,https://api.hive.blog

# ============ Postgres ============
POSTGRES_DB=nftlox_indexer
POSTGRES_USER=nftlox
POSTGRES_PASSWORD=change_me_in_production
# Used by docker-compose.dev.yml only
POSTGRES_PORT=5432

# ============ Hive Account & Multisig ============
# Node account: signs buy transactions and receives the 2.5% fee
# HIVE_ACCOUNT=your-node-account
# Active key (WIF) — imported into beekeeper WASM at startup, never stored in JS
# ACTIVE_KEY=5J...
# Password for the beekeeper wallet (required when ACTIVE_KEY is set)
# BEEKEEPER_PASSWORD=change_me_in_production
MULTISIG_RATE_LIMIT_MAX=10
MULTISIG_RATE_LIMIT_WINDOW_MS=60000
MULTISIG_IP_RATE_LIMIT_MAX=30
MULTISIG_IP_RATE_LIMIT_WINDOW_MS=60000

# ============ App ============
NODE_ENV=development
ENABLE_SWAGGER=true
# Required in production to restrict browser access
# ALLOWED_ORIGINS=https://app.example.com
# Optional: separate port for static health endpoint (0 = disabled)
# HEALTH_PORT=0

# ============ Docker ============
# Override if subnet conflicts with your network (VPN, WSL, etc.)
# DOCKER_SUBNET=172.28.10.0/24

# ============ Nginx (solo con docker-compose.nginx.yml) ============
# PROXY_PORT=80
# PROXY_SSL_PORT=443
# SSL_CERT_PATH=./nginx/ssl
