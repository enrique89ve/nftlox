{
	"name": "nftlox-indexer",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --hot src/index.ts",
		"start:sync": "INDEXER_ROLE=sync bun run src/index.ts",
		"start:api": "INDEXER_ROLE=api bun run src/index.ts",
		"start:monolith": "INDEXER_ROLE=both bun run src/index.ts",
		"test": "./scripts/test.sh",
		"test:filter": "./scripts/test.sh",
		"test:shared": "bun test",
		"typecheck": "bunx tsc --noEmit"
	},
	"engines": {
		"bun": ">=1.1"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/swagger": "^1.3.1",
		"@hiveio/beekeeper": "^1.28.7-rc0",
		"@nftlox/protocol": "workspace:*",
		"elysia": "^1.4.28",
		"hive-tx": "^7.0.1",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	}
}
