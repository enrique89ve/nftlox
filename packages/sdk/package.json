{
	"name": "nftlox-sdk",
	"version": "0.3.0",
	"description": "NFTLox Protocol SDK — Polymorphic Ownership on Hive blockchain",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"files": [
		"dist",
		"src",
		"README.md",
		"GAME-INTEGRATION.md"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"tsup": "^8.5.1",
		"zod": "4.3.6"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=18.0.0"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"dependencies": {
		"@nftlox/protocol": "^0.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
